{
  "name": "@lxagents-mcp/github",
  "version": "0.5.0",
  "description": "MCP server that gives an LLM access to GitHub — repositories, branches, files, commits, tags, releases, issues, pull requests and Actions workflows — through the GitHub REST API. Stdio, or HTTP behind an access token.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "lxagents-github": "src/index.js"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/routes/http.js",
    "test": "node --test",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "LXAgents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-MCP/github.git"
  },
  "homepage": "https://github.com/LXAgents-MCP/github#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-MCP/github/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "lxagents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  }
}
